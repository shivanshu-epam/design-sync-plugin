{
  "name": "Figma-Github-Sync",
  "version": "1.2.2",
  "description": "Sync Figma styles with a design-tokens JSON file in GitHub",
  "main": "code.js",
  "scripts": {
    "build": "npm run build:main && npm run build:ui",
    "build:main": "tsc --noEmit -p tsconfig.json && node scripts/build-main.mjs",
    "build:ui": "tsc --noEmit -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "watch:main": "node scripts/build-main.mjs --watch",
    "watch:ui": "node scripts/build-ui.mjs --watch",
    "watch": "npm run watch:main & npm run watch:ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "",
  "dependencies": {
    "design-sync-schema": "github:shivanshu-epam/Atlassian-design-system#main"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
